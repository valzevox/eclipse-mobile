{
  "name": "eclipse-mobile",
  "version": "1.0.36",
  "main": "main.js",
  "bin": {
    "eclipse": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "valzevox",
  "license": "MIT",
  "description": "Eclipse - Music Player for Android & iOS",
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "buffer": "^6.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "peerjs": "1.5.5",
    "qrcode-generator": "2.0.4",
    "youtubei.js": "^18.1.0"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Eclipse",
  "homepage": "https://github.com/valzevox/eclipse-mobile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valzevox/eclipse-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/valzevox/eclipse-mobile/issues"
  },
  "build": {
    "appId": "com.valzevox.eclipsemobile",
    "productName": "Eclipse",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!bin/**",
      "!mobile/**",
      "!www/**",
      "!ios/**",
      "!android/**",
      "!tools/**",
      "!capacitor.config.json",
      "!.claude/**",
      "!vendor/**",
      "!*.md",
      "!strip_comments.js",
      "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cloverscripts",
        "repo": "eclipse-mobile",
        "releaseType": "release"
      }
    ]
  }
}
